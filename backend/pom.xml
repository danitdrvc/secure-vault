<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.3.5</version>
        <relativePath/>
    </parent>

    <groupId>com.securevault</groupId>
    <artifactId>backend</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <name>secure-vault-backend</name>
    <description>Secure Vault — zero-knowledge backend API</description>

    <properties>
        <java.version>21</java.version>
        <zonky.embedded.version>2.5.1</zonky.embedded.version>
        <jjwt.version>0.12.6</jjwt.version>
        <totp.version>1.7.1</totp.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <!-- Pinuje verziju embedded Postgres binarija na 16 (poklapa se sa postgres:16 iz docker-compose). -->
            <dependency>
                <groupId>io.zonky.test.postgres</groupId>
                <artifactId>embedded-postgres-binaries-bom</artifactId>
                <version>16.2.0</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!-- Faza 1: ORM (Hibernate) + Spring Data JPA repozitorijumi. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>

        <!-- Faza 3: Bean Validation (Hibernate Validator) na DTO-ima. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!-- Faza 4: pun Spring Security filter chain (autentikacija, autorizacija po ulogama,
             stateless sesije sa JWT u HttpOnly kolačićima). Donosi i BCryptPasswordEncoder
             (bcrypt(authKey)) koji je u Fazi 3 dolazio iz samostalnog spring-security-crypto. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>

        <!-- Faza 4: access/refresh/mfa JWT tokeni (jjwt 0.12.x). impl/jackson su runtime. -->
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-api</artifactId>
            <version>${jjwt.version}</version>
        </dependency>
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-impl</artifactId>
            <version>${jjwt.version}</version>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-jackson</artifactId>
            <version>${jjwt.version}</version>
            <scope>runtime</scope>
        </dependency>

        <!-- Faza 4: TOTP (drugi faktor) + otpauth URI / QR kod (dev.samstevens.totp). -->
        <dependency>
            <groupId>dev.samstevens.totp</groupId>
            <artifactId>totp</artifactId>
            <version>${totp.version}</version>
        </dependency>

        <!-- Faza 5: OIDC prijava. Donosi Nimbus JWT dekoder (NimbusJwtDecoder) i OAuth2
             validatore (issuer/timestamp/audience) za proveru id_token-a protiv provajderovog
             JWKS-a. NE koristimo oauth2Login filter (ostajemo stateless sa sopstvenim JWT
             kolačićima) — samo verifikaciju id_token-a. -->
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-oauth2-jose</artifactId>
        </dependency>

        <!-- Flyway: verzionisanje šeme; auto-migrate na startu (Spring Boot integracija). -->
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-core</artifactId>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-database-postgresql</artifactId>
        </dependency>

        <!-- PostgreSQL JDBC driver (runtime). -->
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- Faza 4: Spring Security test podrška (MockMvc security integracija). -->
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-test</artifactId>
            <scope>test</scope>
        </dependency>

        <!--
          Embedded PostgreSQL za @DataJpaTest: pokreće pravi PG binar (ne H2),
          pa Flyway DDL (bytea/jsonb/uuid/pgcrypto) radi identično kao u produkciji.
          Hermetičan test — ne zavisi od Dockera ni od lokalnog PG servisa.
        -->
        <dependency>
            <groupId>io.zonky.test</groupId>
            <artifactId>embedded-database-spring-test</artifactId>
            <version>${zonky.embedded.version}</version>
            <scope>test</scope>
        </dependency>
        <!-- ZONKY provider runtime + PG16 binar za Windows (verzija iz binaries-bom). -->
        <dependency>
            <groupId>io.zonky.test</groupId>
            <artifactId>embedded-postgres</artifactId>
            <version>2.0.7</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.zonky.test.postgres</groupId>
            <artifactId>embedded-postgres-binaries-windows-amd64</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
