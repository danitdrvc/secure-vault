# Kopiraj u .env i popuni stvarnim vrednostima:  cp .env.example .env
# NIKAD ne commit-uj .env (vidi .gitignore).

# --- PostgreSQL ---
POSTGRES_DB=securevault
POSTGRES_USER=vault
POSTGRES_PASSWORD=change-me-strong-password
# JDBC URL koji backend koristi (Faza 1+); host = ime servisa u docker mreži.
DB_URL=jdbc:postgresql://postgres:5432/securevault

# --- Redis ---
REDIS_URL=redis://redis:6379
# Gateway (Faza 9) koristi host/port zasebno (Spring Data Redis Reactive).
REDIS_HOST=redis
REDIS_PORT=6379

# --- Auth / kripto (Faza 4+) ---
# Dugačka random tajna za potpisivanje JWT tokena (npr. `openssl rand -base64 48`).
JWT_SECRET=change-me-long-random-base64-secret
# Server-side ključ za šifrovanje TOTP tajni (bilo koji dug string; svodi se na 32B AES ključ).
SERVER_KMS_KEY=change-me-32-byte-base64-key
# Tehnički prozor access tokena u sekundama (default politike je 300).
ACCESS_TTL=300
# Secure flag na sesijskim kolačićima. Sa HTTPS-om na gateway-u = true (default);
# samo za čist HTTP dev (bez TLS-a na gateway-u) postavi na false.
APP_COOKIE_SECURE=true

# --- OIDC (Faza 5) ---
# OIDC daje SAMO sesiju — master lozinka ostaje obavezna za otključavanje vault-a.
# Dok je OIDC_ENABLED=false, /auth/oidc/** vraća 404.
OIDC_ENABLED=false
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
# Endpointi provajdera (npr. iz njegovog .well-known/openid-configuration).
OIDC_AUTHORIZATION_URI=
OIDC_TOKEN_URI=
OIDC_JWKS_URI=
# Callback (kroz gateway) registrovan kod provajdera + frontend povratni URL-ovi.
OIDC_REDIRECT_URI=https://localhost:8080/api/auth/oidc/callback
OIDC_SCOPES=openid email profile
OIDC_POST_LOGIN_REDIRECT_URI=https://localhost:5173/login?oidc=success
OIDC_POST_LOGIN_ERROR_URI=https://localhost:5173/login?oidc=error

# --- Routing ---
# Gateway -> backend (interno ime servisa u docker mreži).
BACKEND_URI=http://backend:8081
# Origin frontenda za CORS na gateway-u (HTTPS dev server).
FRONTEND_ORIGIN=https://localhost:5173
# URL gateway-a koji frontend (u browseru) gađa (HTTPS, TLS terminira gateway).
VITE_GATEWAY_URL=https://localhost:8080

# --- Gateway TLS (HTTPS) ---
# Gateway je jedina ulazna tačka i terminira TLS. Dev koristi bundlovani self-signed
# keystore (gateway/src/main/resources/keystore.p12). U produkciji zameni keystore
# stvarnim sertifikatom i postavi lozinku/alias ovde. Isključi iza eksternog TLS-a.
SERVER_SSL_ENABLED=true
SERVER_SSL_KEYSTORE=classpath:keystore.p12
SERVER_SSL_KEYSTORE_PASSWORD=changeit
SERVER_SSL_KEY_ALIAS=secure-vault-gateway

# --- Gateway: rate limiting + IP guard (Faza 9) ---
# Deljeni token kojim gateway prijavljuje sigurnosne događaje backendu (/internal/**).
INTERNAL_TOKEN=change-me-long-random-internal-token
# RedisRateLimiter (tokeni/sek + burst): striktno na /api/auth/login/**, blaže globalno.
RL_LOGIN_RATE=5
RL_LOGIN_BURST=10
RL_GLOBAL_RATE=20
RL_GLOBAL_BURST=40
# IpGuardFilter: prag strike-ova (neuspeo login / sumnjiv unos) i trajanja (sekunde).
IPGUARD_MAX_STRIKES=5
IPGUARD_WINDOW_SEC=60
IPGUARD_BLOCK_TTL_SEC=300

# --- Email alarmi + audit anchoring (Faza 10 / 11) ---
# Bez MAIL_HOST: honeypot alarm i audit anchoring se samo loguju (WARN); email se ne šalje.
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
# Primalac admin alarma (honeypot okidač, Faza 10) i audit anchor headHash-a (Faza 11).
ADMIN_EMAIL=
# Periodično sidrenje vrha audit hash-lanca (Faza 11), u milisekundama (default 1h).
AUDIT_ANCHOR_INTERVAL_MS=3600000
AUDIT_ANCHOR_INITIAL_DELAY_MS=3600000
