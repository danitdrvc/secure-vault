# Kopiraj u .env i popuni stvarnim vrednostima:  cp .env.example .env
# NIKAD ne commit-uj .env (vidi .gitignore).

# --- PostgreSQL ---
POSTGRES_DB=securevault
POSTGRES_USER=vault
POSTGRES_PASSWORD=change-me-strong-password
# JDBC URL koji backend koristi (Faza 1+); host = ime servisa u docker mreži.
DB_URL=jdbc:postgresql://postgres:5432/securevault

# --- Redis ---
REDIS_URL=redis://redis:6379

# --- Auth / kripto (Faza 4+) ---
# Dugačka random tajna za potpisivanje JWT tokena (npr. `openssl rand -base64 48`).
JWT_SECRET=change-me-long-random-base64-secret
# Server-side ključ za šifrovanje TOTP tajni (bilo koji dug string; svodi se na 32B AES ključ).
SERVER_KMS_KEY=change-me-32-byte-base64-key
# Tehnički prozor access tokena u sekundama (default politike je 300).
ACCESS_TTL=300
# Secure flag na sesijskim kolačićima. Lokalni dev preko http://localhost = false;
# u produkciji/HTTPS postavi na true.
APP_COOKIE_SECURE=false

# --- OIDC (Faza 5) ---
# OIDC daje SAMO sesiju — master lozinka ostaje obavezna za otključavanje vault-a.
# Dok je OIDC_ENABLED=false, /auth/oidc/** vraća 404.
OIDC_ENABLED=false
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
# Endpointi provajdera (npr. iz njegovog .well-known/openid-configuration).
OIDC_AUTHORIZATION_URI=
OIDC_TOKEN_URI=
OIDC_JWKS_URI=
# Callback (kroz gateway) registrovan kod provajdera + frontend povratni URL-ovi.
OIDC_REDIRECT_URI=http://localhost:8080/api/auth/oidc/callback
OIDC_SCOPES=openid email profile
OIDC_POST_LOGIN_REDIRECT_URI=http://localhost:5173/login?oidc=success
OIDC_POST_LOGIN_ERROR_URI=http://localhost:5173/login?oidc=error

# --- Routing ---
# Gateway -> backend (interno ime servisa u docker mreži).
BACKEND_URI=http://backend:8081
# Origin frontenda za CORS na gateway-u.
FRONTEND_ORIGIN=http://localhost:5173
# URL gateway-a koji frontend (u browseru) gađa.
VITE_GATEWAY_URL=http://localhost:8080
